t-grid {grid-template-columns: 1fr}\n  .faq-row {grid-template-columns: 1fr;gap: 12px}\n}\n</style><main class=\"page-container\">\n\n  <section class=\"hero-grid\">\n    <div class=\"hero-masthead\">\n      <div>\n        <div class=\"hero-tag\">网络架构方案 · 务实交付</div>\n        <h1>新干线</h1>\n      </div>\n      <p>规则透明，分工明确。按量交付流量通道，按需分配多端接入配额。</p>\n    </div>\n\n    <div class=\"hero-quote-block\">\n      <div class=\"quote-mark\">“</div>\n      <p class=\"quote-text\">去掉冗杂噱头，只保留确定的参数、公开的计费与可执行的连接标准。</p>\n      <div class=\"quote-author\">SHINKANSEN PROTOCOL SPEC</div>\n    </div>\n\n    <div class=\"hero-nav-block\">\n      <span class=\"nav-label\">快速检索目录</span>\n      <div class=\"anchor-tags\">\n        <a class=\"anchor-link\" href=\"#plans\">订阅规格</a>\n        <a class=\"anchor-link\" href=\"#guide\">使用说明</a>\n        <a class=\"anchor-link\" href=\"#clients\">支持环境</a>\n        <a class=\"anchor-link\" href=\"#faq\">常见问题</a>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\" class=\"section-wrap\">\n    <div class=\"section-header\">\n      <h2>订阅规格方案</h2>\n      <p>所有档位均标明月度基础额度与并发限制，随时升降配置。</p>\n    </div>\n\n    <div class=\"plan-rows\">\n      <article class=\"plan-item\">\n        <div class=\"plan-meta\">\n          <h3>基础版</h3>\n          <span class=\"plan-badge\">入门轻量</span>\n        </div>\n        <div class=\"plan-pricing\">\n          <div class=\"price-main\">¥15/月</div>\n          <div class=\"price-sub\">按年付仅需 ¥150/年</div>\n        </div>\n        <div class=\"plan-spec-list\">\n          <span class=\"spec-pill\">每月 100GB 极速流量</span>\n          <span class=\"spec-pill\">支持 3 台设备同时在线</span>\n          <span class=\"spec-pill\">解锁基础流媒体</span>\n          <span class=\"spec-pill\">普通线路节点池</span>\n        </div>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"btn-select\">选购配置</a>\n        </div>\n      </article>\n\n      <article class=\"plan-item recommended\">\n        <div class=\"plan-meta\">\n          <h3>旗舰版</h3>\n          <span class=\"plan-badge\">主流选用</span>\n        </div>\n        <div class=\"plan-pricing\">\n          <div class=\"price-main\">¥35/月</div>\n          <div class=\"price-sub\">按年付仅需 ¥350/年</div>\n        </div>\n        <div class=\"plan-spec-list\">\n          <span class=\"spec-pill\">每月 300GB 极速流量</span>\n          <span class=\"spec-pill\">支持 5 台设备同时在线</span>\n          <span class=\"spec-pill\">全节点原生流媒体解锁</span>\n          <span class=\"spec-pill\">IPLC 专线游戏加速优化</span>\n          <span class=\"spec-pill\">7x24 优先工单支持</span>\n        </div>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"btn-select\">选购配置</a>\n        </div>\n      </article>\n\n      <article class=\"plan-item\">\n        <div class=\"plan-meta\">\n          <h3>团队版</h3>\n          <span class=\"plan-badge\">高并发多端</span>\n        </div>\n        <div class=\"plan-pricing\">\n          <div class=\"price-main\">¥85/月</div>\n          <div class=\"price-sub\">按年付仅需 ¥850/年</div>\n        </div>\n        <div class=\"plan-spec-list\">\n          <span class=\"spec-pill\">每月 1000GB 极速流量</span>\n          <span class=\"spec-pill\">支持 20 台设备同时在线</span>\n          <span class=\"spec-pill\">VIP 专属高带宽节点</span>\n          <span class=\"spec-pill\">支持企业定制路由</span>\n          <span class=\"spec-pill\">专属客户经理服务</span>\n        </div>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"btn-select\">选购配置</a>\n        </div>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"guide\" class=\"section-wrap\">\n    <div class=\"section-header\">\n      <h2>使用说明</h2>\n      <p>三步完成配置，无需复杂调试。</p>\n    </div>\n\n    <div class=\"setup-guide-grid\">\n      <div class=\"setup-card\">\n        <div class=\"setup-step\">步骤 01</div>\n        <h3>获取订阅凭证</h3>\n        <p>确认订阅版本后，系统自动生成唯一专属订阅链接与密钥代码。</p>\n      </div>\n\n      <div class=\"setup-card\">\n        <div class=\"setup-step\">步骤 02</div>\n        <h3>导入应用配置</h3>\n        <p>将订阅链接粘贴至所选系统的适配内核工具中，执行节点同步。</p>\n      </div>\n\n      <div class=\"setup-card\">\n        <div class=\"setup-step\">步骤 03</div>\n        <h3>启动规则连接</h3>\n        <p>选择推荐路由策略或手动指定线路，确认流量统计正常后开始使用。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\" class=\"section-wrap\">\n    <div class=\"section-header\">\n      <h2>支持环境</h2>\n      <p>标准协议支持，灵活适配各平台常用网络调试工具。</p>\n    </div>\n\n    <div class=\"client-block\">\n      <div class=\"client-info\">\n        <p>新干线通过标准订阅格式分发参数，不强制绑定专有闭源客户端。用户可使用符合主流标准规范的通用开源或第三方网络管理工具接入。</p>\n      </div>\n      <div class=\"client-grid\">\n        <div class=\"client-item\">\n          <div class=\"client-name\">Windows</div>\n          <div class=\"client-desc\">支持通用订阅导入及分流规则配置</div>\n        </div>\n        <div class=\"client-item\">\n          <div class=\"client-name\">macOS</div>\n          <div class=\"client-desc\">适配菜单栏常驻工具，保持后台轻量运行</div>\n        </div>\n        <div class=\"client-item\">\n          <div class=\"client-name\">Android</div>\n          <div class=\"client-desc\">支持按应用分流与配置文件快速热更新</div>\n        </div>\n        <div class=\"client-item\">\n          <div class=\"client-name\">iOS &amp; iPadOS</div>\n          <div class=\"client-desc\">兼容主流代理配置文件扫码导入与策略组</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\" class=\"section-wrap\">\n    <div class=\"section-header\">\n      <h2>常见问题</h2>\n      <p>技术细节与规则释疑。</p>\n    </div>\n\n    <div class=\"faq-numbered-list\">\n      <article class=\"faq-row\">\n        <div class=\"faq-num\">01</div>\n        <div class=\"faq-content\">\n          <h3>同时在线设备数如何界定？</h3>\n          <p>系统按发起网络请求的活跃 IP 和设备标识综合统计。超出配额时，新接入设备将排队或阻断，旧连接不受强制断开影响。</p>\n        </div>\n      </article>\n\n      <article class=\"faq-row\">\n        <div class=\"faq-num\">02</div>\n        <div class=\"faq-content\">\n          <h3>当月套餐流量耗尽后如何处理？</h3>\n          <p>配额用尽后服务将暂停连接。用户可在控制台选择购买临时流量增补包，或直接升级到更高阶订阅方案重置额度。</p>\n        </div>\n      </article>\n\n      <article class=\"faq-row\">\n        <div class=\"faq-num\">03</div>\n        <div class=\"faq-content\">\n          <h3>不同套餐之间的节点分配有何区别？</h3>\n          <p>基础版使用公共普通线路池。旗舰版加入 IPLC 优化通道并提升流媒体支持度。团队版专享独立预留带宽与多并发优化线路。</p>\n        </div>\n      </article>\n\n      <article class=\"faq-row\">\n        <div class=\"faq-num\">04</div>\n        <div class=\"faq-content\">\n          <h3>订阅地址支持多平台同时更新吗？</h3>\n          <p>支持。同一订阅链接可在多台授权终端中分别导入。各终端可独立设置更新周期，互不冲突。</p>\n        </div>\n      </article>\n    </div>\n  </section>\n\n  <footer class=\"site-footer\">\n    <div>新干线 · 规范化数据路由分发体系</div>\n    <div>内容仅作技术方案规格与配置展示，请遵守相关网络使用准则。</div>\n  </footer>\n\n</main>",
